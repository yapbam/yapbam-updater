<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.fathzer</groupId>
    <artifactId>parent-pom</artifactId>
    <version>1.1.0</version>
  </parent>
  <artifactId>yapbam-updater</artifactId>
  <version>1.1.0</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mainClass>net.yapbam.updater.Updater</mainClass>
  </properties>

  <name>Yapbam-updater</name>
  <url>https://www.yapbam.net</url>
  <description>Updater for Yapbam desktop application.</description>

  <scm>
    <url>https://github.com/yapbam/yapbam-updater.git</url>
    <connection>https://github.com/yapbam/yapbam-updater.git</connection>
  </scm>

  <dependencies>
    <dependency>
      <groupId>com.fathzer</groupId>
      <artifactId>ajlib</artifactId>
      <version>0.3.18</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.2.1</version>
        <executions>
          <execution>
            <id>enforce-bytecode-version</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <enforceBytecodeVersion>
                    <maxJdkVersion>1.8</maxJdkVersion>
                    <ignoredScopes>
                      <ignoreScope>test</ignoreScope>
                    </ignoredScopes>
                  </enforceBytecodeVersion>
                </rules>
                <fail>true</fail>
              </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>1.6.1</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <minimizeJar>true</minimizeJar>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>license/**</exclude>
                    <exclude>mozilla/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- ajlib swing stuff and resources are not used by the updater -->
                  <artifact>com.fathzer:ajlib</artifact>
                  <excludes>
                    <exclude>com/fathzer/soft/ajlib/swing/**</exclude>
                    <exclude>com/fathzer/soft/ajlib/Resources*.properties</exclude>
                    <exclude>com/fathzer/soft/ajlib/utilities/WindowsShortcut.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${mainClass}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
